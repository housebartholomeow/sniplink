# ==========================================
# POSTGRESQL DATABASE CREDENTIALS
# These are used by docker-compose.yml to 
# configure PgBouncer and build the connection
# ==========================================
DB_USER="db_user"
DB_PASSWORD="db_password"
DB_NAME="db_name"

# ==========================================
# CONNECTION STRINGS
# ==========================================

# 1. PGBOUNCER  (Used by Docker)
# Tells PgBouncer inside Docker how to reach your actual database on your host machine.
# Format: postgresql://USER:PASSWORD@host.docker.internal:5432/DB_NAME
PGBOUNCER_URL="postgresql://db_user:db_password@host.docker.internal:5432/db_name"

# 2. DATABASE URL (Used by Drizzle/Host)
# Bypasses PgBouncer entirely. Used ONLY when running `node migrate.js` or `npx drizzle-kit` on your host machine.
# Format: postgresql://USER:PASSWORD@localhost:5432/DB_NAME
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_name"

# ==========================================
# CACHE & MESSAGING
# ==========================================

# Redis connection string. 
# Inside Docker, use "redis://redis:6379". If running the Node app locally without Docker, use "redis://localhost:6379".
REDIS_URL="redis://redis:6379"

# Kafka broker connection.
# Inside Docker, use "kafka:29092".
KAFKA_BROKER="kafka:29092"

BASE_URL="http://localhost:8080"
# ==========================================
# APPLICATION SETTINGS
# ==========================================
PORT=3000
NODE_ENV="development"